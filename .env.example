# Hugging Face token required for pyannote speaker diarization
# Create a token with READ permission at https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Permanent cache directory outside the virtual environment (recommended)
# Use forward slashes (/) to avoid escape issues in some parsers.
# e.g., D:/huggingface_cache or C:/Users/YourUsername/.cache/huggingface
HF_HOME=D:/huggingface_cache

# Enable offline mode once models are downloaded to avoid network checks
# HF_HUB_OFFLINE=1
